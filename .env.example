DATABASE_URL=postgresql://user:password@host:5432/ordenanzas

# API Keys (para servidor MCP y procesamiento con IA)
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...         # Para resúmenes y embeddings (usará OPENAI_API_KEY por defecto)
OPENAI_API_KEY=gsk_...       # (usará GROQ_API_KEY por defecto)
DEEPSEEK_API_KEY=sk-...     # Para procesador concurrente de DeepSeek

# Opcionales
VERBOSE=false               # Habilita logging detallado
LOG_LEVEL=info             # debug, info, warn, error
NODE_ENV=development         # Formato pretty de logs
