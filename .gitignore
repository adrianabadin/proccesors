# ─── Dependencias ─────────────────────────────────────────────
node_modules/

# ─── Build / compilado ────────────────────────────────────────
dist/
build/
*.js.map
*.d.ts.map

# ─── Secrets y configuración local ───────────────────────────
.env
.env.local
.env.*.local

# ─── Claude Code (sesiones y memoria local) ───────────────────
.claude/

