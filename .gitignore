database/
*.sql
*.dump
*.db
*.sqlite

# ─── Archivos de prueba con API keys hardcodeadas ─────────────
test-glm.ts

# ─── Artefactos de scraping / experimentos descartados ────────
cosa.html
cosa.js

# ─── Drizzle migrations generadas (se regeneran con db:generate)
